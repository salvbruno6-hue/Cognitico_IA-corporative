# Public browser-safe values only.
NEXT_PUBLIC_ELO_APP_NAME="ELO"
NEXT_PUBLIC_ELO_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional public tenant identifier.
NEXT_PUBLIC_ELO_TENANT_ID="multiteiner"

# Render:
# Set NEXT_PUBLIC_ELO_SITE_URL to the public Render URL.
# The Google OAuth callback is generated from window.location.origin:
# https://<render-host>/auth/callback
